# Variáveis do projeto de API na Vercel (Root Directory: .)
# Nunca comite um .env com valores reais.

APP_ENV=production

# O auth usa Turso/libSQL quando as duas variáveis abaixo estão preenchidas.
# O padrão sqlite:///./quimix_auth.db só vale para desenvolvimento local.
TURSO_DATABASE_URL=libsql://SEU-BANCO-ORG.turso.io
TURSO_AUTH_TOKEN=SEU_TOKEN_DO_TURSO

# Fallback usado apenas se TURSO_DATABASE_URL estiver vazio.
DATABASE_URL=sqlite:///./quimix_auth.db

# Troque por um secreto aleatório com 32+ caracteres.
JWT_SECRET=troque-esta-chave-por-uma-string-aleatoria-de-32-caracteres-ou-mais

# URL exata do projeto da web, sem barra no final.
CORS_ORIGINS=https://quimix-web-chromick.vercel.app

# "none" desativa o regex padrão quimix*.vercel.app.
CORS_ORIGIN_REGEX=none

# Não crie admin automático em produção.
SEED_ADMIN_ENABLED=false
